{
  "name": "codegent",
  "private": true,
  "version": "0.1.0",
  "description": "Seamless agentic coding on a free ChatGPT account: VS Code extension + browser extension + local hub.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohammadAsadolahi/CodeGent.git"
  },
  "bugs": {
    "url": "https://github.com/MohammadAsadolahi/CodeGent/issues"
  },
  "homepage": "https://github.com/MohammadAsadolahi/CodeGent#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --config config/vitest.config.ts",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:watch": "vitest --config config/vitest.config.ts",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node apps/vscode/scripts/make-icons.mjs",
    "package": "npm run package -w apps/vscode",
    "test:live": "npm run test:live -w apps/vscode",
    "test:package": "npm run test:package -w apps/vscode",
    "release": "node apps/vscode/scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "~0.25.12",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 90,
    "endOfLine": "lf"
  }
}
